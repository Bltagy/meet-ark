# ==============================================================================
# Meet-Ark Production Environment Configuration (.env.production.example)
#
# COPY THIS FILE TO .env.production AND FILL IN ALL PLACEHOLDERS BEFORE DEPLOYING.
# DO NOT COMMIT .env.production OR ANY SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Container Runtime Configuration
# ------------------------------------------------------------------------------
# Persistent storage directory for Jitsi configs and Prosody data
CONFIG=./data/jitsi-meet-cfg

# Container restart policy
RESTART_POLICY=unless-stopped

# System timezone
TZ=UTC

# Pinned Docker image version for all Jitsi services (do not use floating 'latest')
JITSI_IMAGE_VERSION=stable-9955

# ------------------------------------------------------------------------------
# 2. Domains, URLs, and Network Binding
# ------------------------------------------------------------------------------
# Replace with your actual domain names (FQDNs)
# Domain for Meet-Ark Laravel application
APP_URL=https://app.yourdomain.com

# Domain for Jitsi Meet video conferencing
PUBLIC_URL=https://meet.yourdomain.com
JITSI_PUBLIC_URL=https://meet.yourdomain.com

# Port bindings for HTTP loopback behind host/edge reverse proxy (Nginx/Caddy/Traefik).
# Bound strictly to 127.0.0.1 so unencrypted internal traffic is never exposed to the public Internet.
APP_PORT=127.0.0.1:8088
HTTP_PORT=127.0.0.1:8000
HTTPS_PORT=127.0.0.1:8443

# Edge reverse proxy handles TLS termination and HTTP->HTTPS redirection
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

# ------------------------------------------------------------------------------
# 3. Jitsi Videobridge (JVB) Media Routing
# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION: Public IPv4 address of the Linux host.
# Remote clients connect to this IP on UDP 10000 for WebRTC video and audio streams.
# DO NOT set this to 127.0.0.1 or localhost in production.
JVB_ADVERTISE_IPS=YOUR_SERVER_PUBLIC_IPV4

# Public UDP port for WebRTC media transport
JVB_PORT=10000

# ------------------------------------------------------------------------------
# 4. Whiteboard Integration (Excalidraw)
# ------------------------------------------------------------------------------
WHITEBOARD_COLLAB_SERVER_URL_BASE=http://whiteboard.meet.jitsi

# ------------------------------------------------------------------------------
# 5. Database Configuration (Private to internal Docker network)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meet_ark
DB_USERNAME=meet_ark
# Replace with a strong, randomly generated database password (e.g. openssl rand -hex 16)
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ------------------------------------------------------------------------------
# 6. Laravel Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# REQUIRED: 32-character base64 application encryption key.
# Generate on host using: docker compose ... exec app php artisan key:generate --show
APP_KEY=REPLACE_WITH_BASE64_APP_KEY

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 7. Server-Side Token Authentication (JWT Boundary)
# ------------------------------------------------------------------------------
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt

JWT_APP_ID=meet_ark_backend
JWT_ACCEPTED_ISSUERS=meet_ark_backend
JWT_ACCEPTED_AUDIENCES=meet_ark_platform

# REQUIRED: 64-character hex shared secret for HS256 token signing.
# Generate using: openssl rand -hex 32
JWT_APP_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

XMPP_MUC_MODULES=token_moderation
XMPP_MUC_CONFIGURATION=restrict_room_creation = "local"
ENABLE_AUTO_OWNER=false

# ------------------------------------------------------------------------------
# 8. Jitsi Internal Cluster Passwords
# Generate each with: openssl rand -hex 16 (or use scripts/gen-passwords.sh)
# ------------------------------------------------------------------------------
JICOFO_AUTH_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
JVB_AUTH_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
JIGASI_XMPP_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
JIGASI_TRANSCRIBER_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
JIBRI_RECORDER_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
JIBRI_XMPP_PASSWORD=REPLACE_WITH_RANDOM_HEX_16
