# Stage 1: Install Composer production dependencies
FROM composer:latest AS composer-builder

WORKDIR /app

COPY application/composer.json application/composer.lock ./
RUN composer install --no-dev --no-scripts --prefer-dist --no-interaction --no-autoloader


# Stage 2: Compile frontend assets with Node 22 (requires Ziggy from vendor)
FROM node:22-alpine AS frontend-builder

WORKDIR /app

COPY application/package*.json ./
RUN npm ci

COPY application/ ./

# Copy vendor from composer-builder so ZiggyVue import resolves
COPY --from=composer-builder /app/vendor ./vendor

RUN npm run build


# Stage 3: Production PHP-FPM + Nginx runtime
FROM php:8.4-fpm-alpine

# Install system utilities, runtime libraries, Nginx, and Supervisor
RUN apk add --no-cache \
    bash \
    curl \
    git \
    postgresql-client \
    postgresql-dev \
    libzip-dev \
    icu-dev \
    linux-headers \
    nginx \
    supervisor

# Install required PHP extensions
RUN docker-php-ext-install \
    pdo \
    pdo_pgsql \
    pgsql \
    bcmath \
    zip \
    pcntl \
    intl \
    opcache

# Recommended PHP production settings
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.revalidate_freq=2'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=0'; \
} > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Get Composer binary from official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy application code
COPY application/ ./

# Copy vendor dependencies from composer-builder
COPY --from=composer-builder /app/vendor ./vendor

# Copy compiled frontend assets from frontend-builder
COPY --from=frontend-builder /app/public/build ./public/build

# Clear any stale bootstrap caches and optimize autoloader
RUN rm -f bootstrap/cache/*.php && composer dump-autoload --optimize --no-dev

# Configure Nginx to serve Laravel on port 8088
COPY docker/app/nginx-laravel.conf /etc/nginx/http.d/default.conf
RUN mkdir -p /run/nginx

# Configure Supervisord to manage PHP-FPM and Nginx
COPY docker/app/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Setup directory structure and permissions
RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Copy production entrypoint
COPY docker/app/entrypoint-prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8088

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
