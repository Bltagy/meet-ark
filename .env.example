# ==============================================================================
# Meet-Ark Environment Configuration (.env.example)
# Phase 1: Local Docker Meeting Foundation with Whiteboard Support
# ==============================================================================

# Directory where persistent container configurations and SSL keys are stored.
# Relative to repository root or absolute path.
CONFIG=./data/jitsi-meet-cfg

# Exposed HTTP port (used for redirect to HTTPS or ACME challenge in production)
HTTP_PORT=8000

# Exposed HTTPS port for the web interface and WebSockets
HTTPS_PORT=8443

# System time zone
TZ=UTC

# Public URL for the web service.
# For local same-machine browser testing: https://localhost:8443
# For cross-device local testing: https://<HOST_LAN_IP>:8443
# For production server: https://meet.yourdomain.com
PUBLIC_URL=https://localhost:8443

# Media IP addresses advertised by the Jitsi Videobridge (JVB).
# In local Docker Desktop environments (macOS/Windows), the container bridge IP
# is not directly routable from the host. Set this to 127.0.0.1 for local host testing,
# or your machine's LAN IP (e.g. 192.168.1.50) if testing with another device on the LAN.
# For production, set to your server's public IP address.
JVB_ADVERTISE_IPS=127.0.0.1

# JVB media UDP port (WebRTC audio/video transport)
JVB_PORT=10000

# Container restart policy
RESTART_POLICY=unless-stopped

# Pinned Docker image version for all Jitsi services (do not use floating 'latest')
JITSI_IMAGE_VERSION=stable-9955

# ==============================================================================
# Whiteboard Integration (Excalidraw)
# ==============================================================================
# Excalidraw collaboration backend runs as the 'whiteboard' container on the meet.jitsi network.
# The web container's Nginx reverse-proxies /socket.io/ to this internal URL.
WHITEBOARD_COLLAB_SERVER_URL_BASE=http://whiteboard.meet.jitsi

# ==============================================================================
# HTTPS & Security Settings
# ==============================================================================
# Enable HTTP to HTTPS redirection (1 = enabled, 0 = disabled)
ENABLE_HTTP_REDIRECT=1

# Disable HTTPS entirely (0 = HTTPS enabled with generated/mounted certs)
DISABLE_HTTPS=0

# Let's Encrypt (Production only - Leave disabled for local testing)
ENABLE_LETSENCRYPT=0
#LETSENCRYPT_DOMAIN=meet.yourdomain.com
#LETSENCRYPT_EMAIL=admin@yourdomain.com
#LETSENCRYPT_USE_STAGING=0

# ==============================================================================
# Passwords & Service Authentication Credentials
# (Run ./scripts/gen-passwords.sh to generate random secure credentials)
# DO NOT commit real passwords or .env to version control!
# ==============================================================================
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

# ==============================================================================
# Authentication Boundary (Phase 3: Server-Side Token Authentication)
# ==============================================================================
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=meet_ark_backend
# Generate a 64-character secret with: openssl rand -hex 32
JWT_APP_SECRET=replace_with_openssl_rand_hex_32
JWT_ACCEPTED_ISSUERS=meet_ark_backend
JWT_ACCEPTED_AUDIENCES=meet_ark_platform
XMPP_MUC_MODULES=token_moderation
XMPP_MUC_CONFIGURATION=restrict_room_creation = "local"
ENABLE_AUTO_OWNER=false

# ==============================================================================
# Application Stack (Phase 2: Laravel + Vue 3 Inertia & PostgreSQL)
# ==============================================================================
APP_PORT=8088
APP_URL=http://localhost:8088
DB_DATABASE=meet_ark
DB_USERNAME=meet_ark
DB_PASSWORD=secretpassword

